{
  "name": "business-app-server",
  "version": "1.0.0",
  "description": "Production-ready Express + Prisma backend for business website",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "build": "prisma generate",
    "prisma:generate": "prisma generate",
