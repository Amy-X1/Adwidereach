# ----------------------------
# Server
# ----------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ----------------------------
# Database
# Default below uses SQLite for zero-config local development.
# For production, switch provider in prisma/schema.prisma to "postgresql"
# and use something like:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/business_app?schema=public"
# ----------------------------
DATABASE_URL="file:./dev.db"

# ----------------------------
# JWT
# ----------------------------
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_this_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# ----------------------------
# Bcrypt
# ----------------------------
BCRYPT_SALT_ROUNDS=12

# ----------------------------
# Rate Limiting
# ----------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ----------------------------
# Email (SMTP) — for password reset codes
# Leave empty for local dev: codes are logged + returned as devCode.
# For Gmail: host=smtp.gmail.com port=587 user=you@gmail.com pass=<app-password>
# ----------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AdWideReach <no-reply@adwidereach.com>

# ----------------------------
# Admin seed account (used by prisma/seed.js)
# ----------------------------
ADMIN_EMAIL=admin@business.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
